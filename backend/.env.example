# Copy this file to ".env" and fill in your own values. NEVER commit the real .env file.

# Port the API listens on
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=book_haven

# Secret used to sign login tokens (JWT). Use a long random string, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Address of the React app (CORS only allows this origin). Separate several with commas.
CLIENT_ORIGIN=http://localhost:5173
